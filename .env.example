# Copiar a .env NO es suficiente: este backend no carga archivos .env automaticamente.
# Exporte estas variables en el proceso (PowerShell: $env:DATABASE_URL="...").
# No use credenciales reales en este archivo. La base SICIS no debe usarse.

# Obligatoria. Base PostgreSQL dedicada y nueva del proyecto.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/relevo_dev

# Servidor
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=false

# Cookies / sesión persistente en PostgreSQL
COOKIE_NAME=relevo_session
COOKIE_SECURE=false
SESSION_TTL_MINUTES=480
DATABASE_POOL_MAX=10

# Orígenes permitidos del frontend local (separados por coma). Vacío desactiva CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limitadores en memoria (se reinician al reiniciar el proceso)
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_MINUTES=15
TRACK_RATE_LIMIT=20
TRACK_RATE_WINDOW_MINUTES=15

# Notificaciones outbox: local (bandeja de consola/archivo) o smtp.
# local no equivale a correo externo entregado.
NOTIFICATIONS_MODE=local
NOTIFICATIONS_AUTO_PROCESS=true
NOTIFICATIONS_INTERVAL_MS=15000
NOTIFICATIONS_FROM=no-reply@relevo.local
# Opcional en modo local. Si se define, cada mensaje se agrega como JSONL.
# NOTIFICATIONS_LOCAL_FILE=server/var/notifications.jsonl

# SMTP opcional (solo se usa con NOTIFICATIONS_MODE=smtp)
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Relevo <no-reply@example.invalid>

# Seed sintético. Cambie la contraseña si publica la base de demostración.
SEED_DEMO_PASSWORD=RelevoDemo2026!
# El seed se niega en NODE_ENV=production salvo ALLOW_SEED=1.
# ALLOW_SEED=1
